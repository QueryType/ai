# Copy to .env and fill in your own endpoints. All of these are optional --
# CLI flags always override the corresponding env var, and env var absent
# falls back to the CLI's built-in default.

# OpenAI-compatible LLM endpoint (llama-server, LM Studio, vLLM, ...)
IMAGER_LLM_URL=http://localhost:8080/v1
IMAGER_LLM_MODEL=local-model
# Bearer token for the LLM endpoint's Authorization header. Only needed for
# hosted/authenticated OpenAI-compatible APIs; local servers (llama-server,
# LM Studio) ignore it. Keep this in .env, never in shell history or a
# CLI flag on a shared machine -- .env is gitignored.
IMAGER_LLM_API_KEY=
# LM Studio only: the `lms load`/`lms unload` key, which can differ from
# IMAGER_LLM_MODEL above (check with `lms ls`). Used by
# scripts/run_full_pipeline.sh to toggle VRAM between the LLM and ComfyUI.
IMAGER_LMS_MODEL_KEY=

# Image generation backend for the `images` stage: comfy | drawthings
IMAGER_BACKEND=comfy

# ComfyUI instance, used when IMAGER_BACKEND=comfy
IMAGER_COMFY_URL=http://127.0.0.1:8188
IMAGER_WORKFLOW_FILE=workflows/flux2_klein_9b.json

# Draw Things instance, used when IMAGER_BACKEND=drawthings -- enable
# "API Server" in Draw Things' Settings first. No workflow file needed;
# it uses whichever checkpoint/sampler is currently selected in the app.
IMAGER_DRAWTHINGS_URL=http://127.0.0.1:7860
# Leave IMAGER_WIDTH/IMAGER_HEIGHT unset to use whatever size is currently
# configured in the Draw Things UI; set them here only to force a size.
#IMAGER_WIDTH=1024
#IMAGER_HEIGHT=1024

# Prompt composition style -- set IMAGER_MODEL_FAMILY to a known checkpoint
# family (flux2, zimage -> prose; sdxl -> tags), or IMAGER_PROMPT_STYLE
# directly (prose|tags) to override. Default is prose if neither is set.
IMAGER_MODEL_FAMILY=flux2

# Approx max chars per chunk for the bible/scenes LLM passes
IMAGER_CHUNK_BUDGET_CHARS=6000

# Concurrent LLM calls during bible/scenes stages -- match your LLM
# server's parallel slot count (set to 1 for a single-slot server)
IMAGER_PARALLEL=4
