# Where scenario .md files live — deliberately outside this project.
# Normally exported from your shell rather than set here; a shell export wins
# over this file. Required: there is no in-project fallback.
# SCENARIO_LOC=/path/to/your/scenarios

# Where chat history is written. Unset means beside the scenario file, as
# <name>.session.json — keeps each scenario folder self-contained.
# SESSION_LOC=/path/to/your/chats

# Inference server — any OpenAI-compatible endpoint
CHAT_BASE_URL=http://192.168.1.2:7890/v1
CHAT_API_KEY=not-needed
CHAT_MODEL=google/gemma-4-12b-qat

# Declared, not probed — probing this means deliberately overflowing the server
CHAT_CONTEXT_TOKENS=262144
CHAT_PARALLEL_SLOTS=2

CHAT_TEMPERATURE=0.9

# Latency targets the policy layer sizes its token budgets against
CHAT_TARGET_APPEND_MS=700
CHAT_TARGET_REPLY_SECONDS=2.5

# Fails a stalled request loudly instead of hanging indefinitely
CHAT_REQUEST_TIMEOUT_SECONDS=60

# Continuations: characters answering each other without you typing a turn.
# 0 disables. See PLAN_CONTINUATIONS.md.
CHAT_CONTINUATION_MAX=2
CHAT_CONTINUATION_CHANCE=0.25

# Same as above, but for scenarios with a `mode: f2f` line — looser, since
# real in-person talk overlaps constantly and rarely uses names. See PLAN_F2F.md.
CHAT_F2F_CONTINUATION_MAX=5
CHAT_F2F_CONTINUATION_CHANCE=0.6

# Reply-length budget for `mode: f2f` scenarios — same idea as
# CHAT_TARGET_REPLY_SECONDS, just a bigger allowance for longer in-person turns.
CHAT_TARGET_REPLY_SECONDS_F2F=6.0

# Idle-timer continuations: after this many seconds of silence from you, the
# cast re-checks whether to keep talking (same decide() policy, same caps —
# it will usually do nothing, biased hard toward not badgering you). Works in
# both the terminal and web UI. 0 disables.
CHAT_IDLE_SECONDS=45

# Same as above, for scenarios with a `mode: f2f` line — longer, since F2F's
# replies and continuation chains already run longer per turn; 45s of literal
# silence feels rushed against that slower pace. See PLAN_F2F.md.
CHAT_IDLE_SECONDS_F2F=120

# Vision: longest edge, in pixels, an attached image is downscaled to before
# it's ever saved or sent. A latency/context budget, same idea as
# CHAT_TARGET_REPLY_SECONDS — an un-downscaled photo costs an unpredictable
# number of tokens on every future turn that includes it. No effect if the
# configured model isn't multimodal (probed, not assumed — see profiles/).
CHAT_VISION_MAX_DIMENSION=1024

# Web UI bind address — `python -m src <scenario> --ui web`. Loopback only by
# default; this is a personal local tool, not something to expose.
CHAT_WEB_HOST=127.0.0.1
CHAT_WEB_PORT=8000
